{
  "name": "cx-jev-tidy",
  "version": "0.1.9",
  "description": "Lets cx clear old step results, but keep every word written.",
  "license": "MIT",
  "author": "ComChatX",
  "comchatx": {
    "name": "Jev Cleanup",
    "about": "让 cx 清掉长对话里用不上的步骤结果，说过的话一字不删。",
    "mark": {
      "line": "chat"
    },
    "section": "extensions",
    "order": 70,
    "builds": [
      {
        "on": "jev",
        "why": {
          "en": "Judges which step results are no longer needed.",
          "zh": "判断哪些步骤结果已经用不上。"
        }
      }
    ]
  },
  "homepage": "https://github.com/comchatx/cx-jev-tidy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-jev-tidy.git"
  },
  "bugs": "https://github.com/comchatx/cx-jev-tidy/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/extensions"
    ]
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@comchatx/typesafe": "^0.1.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "26.2.0",
    "esbuild": "0.27.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0"
  }
}
